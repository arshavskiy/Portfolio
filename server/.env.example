PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=https://stockfolio.handcoded.tech
# Extra allowed origins (comma-separated, no trailing slash). The production
# domain https://stockfolio.handcoded.tech is also hardcoded in index.js.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://stockfolio.handcoded.tech
ALLOW_VERCEL_PREVIEWS=true
NODE_ENV=production

# Google Sign-In (create an OAuth Client ID at console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Web Push (generate with: node -e "console.log(require('web-push').generateVAPIDKeys())")
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Optional: shared cache for market data across server instances. If unset,
# an in-process cache is used (fine for a single instance).
# REDIS_URL=redis://localhost:6379

# Optional: enables the dashboard Market News card via a financial news API.
# Without a news API key, the server falls back to Yahoo Finance search news.
# FINNHUB_API_KEY=your_finnhub_api_key
# MARKETAUX_API_TOKEN=your_marketaux_api_token

# Optional: enables the Insights "Ask About Your Portfolio" AI Q&A feature.
# Without a key, POST /stocks/ai-ask returns a 503.
# OPENAI_API_KEY=your_openai_api_key
