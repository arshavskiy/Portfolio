          "content": "\u003cscript setup\u003e\nimport { ref, onMounted } from 'vue'\nimport { useCurrency, gainLossClass } from '@/composables/useFormat'\nimport api from '@/composables/useApi'\nimport Tag from 'primevue/tag'\n\nconst transactions = ref([])\nconst loading = ref(false)\n\nonMounted(async () =\u003e {\n  loading.value = true\n  try {\n    const data = await api.get('/portfolio/transactions?limit=100')\n    transactions.value = data.transactions\n  } finally {\n    loading.value = false\n  }\n})\n\nfunction formatDate(d) {\n  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n}\n\u003c/script\u003e\n\n\u003ctemplate\u003e\n  \u003cdiv class=\"transactions\"\u003e\n    \u003cheader class=\"page-header\"\u003e\n      \u003ch1\u003eHistory\u003c/h1\u003e\n    \u003c/header\u003e\n\n    \u003cdiv v-if=\"loading\" class=\"text-muted\"\u003eLoading...\u003c/div\u003e\n\n    \u003cdiv v-else-if=\"!transactions.length\" class=\"empty\"\u003e\n      \u003ci class=\"pi pi-list\" /\u003e\n      \u003cp class=\"text-muted\"\u003eNo transactions yet\u003c/p\u003e\n    \u003c/div\u003e\n\n    \u003cdiv v-else class=\"tx-list\"\u003e\n      \u003cdiv v-for=\"tx in transactions\" :key=\"tx._id\" class=\"tx-row\"\u003e\n        \u003cdiv class=\"tx-left\"\u003e\n          \u003cspan class=\"ticker\"\u003e{{ tx.ticker }}\u003c/span\u003e\n          \u003cspan class=\"tx-date text-muted\"\u003e{{ formatDate(tx.date) }}\u003c/span\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"tx-mid\"\u003e\n          \u003cspan class=\"text-muted\"\u003e{{ tx.shares }} shares @ {{ useCurrency(tx.price) }}\u003c/span\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"tx-right\"\u003e\n          \u003cTag :value=\"tx.type.toUpperCase()\" :severity=\"tx.type === 'buy' ? 'success' : 'danger'\" /\u003e\n          \u003cspan class=\"total\"\u003e{{ useCurrency(tx.total) }}\u003c/span\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/template\u003e\n\n\u003cstyle scoped\u003e\n.transactions { padding: 1rem; }\n.page-header { margin-bottom: 1.5rem; }\n.page-header h1 { font-size: 1.5rem; font-weight: 700; }\n.empty { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding: 3rem 1rem; }\n.empty i { font-size: 3rem; color: var(--text-secondary); }\n.tx-list { display: flex; flex-direction: column; }\n.tx-row { display: flex; align-items: center; padding: 0.85rem 0; border-bottom: 1px solid var(--border); gap: 0.5rem; }\n.tx-left { flex: 1; }\n.ticker { font-weight: 600; display: block; }\n.tx-date { font-size: 0.78rem; }\n.tx-mid { flex: 1; font-size: 0.82rem; }\n.tx-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }\n.total { font-size: 0.9rem; font-weight: 500; }\n\u003c/style\u003e\n",
