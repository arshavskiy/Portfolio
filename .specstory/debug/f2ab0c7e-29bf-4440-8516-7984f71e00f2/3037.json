          "new_string": "      \u003c!-- Combined multi-currency total --\u003e\n      \u003cdiv v-if=\"portfolio.totals.length \u003e 0\" class=\"summary-card\"\u003e\n        \u003cp class=\"summary-label\"\u003eTotal Portfolio\u003c/p\u003e\n        \u003cp class=\"summary-value combined-value\"\u003e\n          \u003cspan v-for=\"(t, i) in portfolio.totals\" :key=\"t.currency\"\u003e\n            \u003cspan v-if=\"i \u003e 0\" class=\"plus\"\u003e + \u003c/span\u003e\n            {{ useCurrency(t.value, t.currency) }}\n          \u003c/span\u003e\n        \u003c/p\u003e\n        \u003cp class=\"summary-pnl combined-pnl\"\u003e\n          \u003cspan v-for=\"(t, i) in portfolio.totals\" :key=\"t.currency\" :class=\"gainLossClass(t.pnl)\"\u003e\n            \u003cspan v-if=\"i \u003e 0\" class=\"text-muted\"\u003e · \u003c/span\u003e\n            {{ t.pnl \u003e= 0 ? '+' : '' }}{{ useCurrency(t.pnl, t.currency) }} ({{ usePercent(t.pnlPercent) }})\n          \u003c/span\u003e\n        \u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv v-else class=\"summary-card\"\u003e\n        \u003cp class=\"summary-label\"\u003eTotal Portfolio\u003c/p\u003e\n        \u003cp class=\"summary-value\"\u003e$0.00\u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Day P\u0026L per currency --\u003e\n      \u003cdiv class=\"day-card\" :class=\"gainLossClass(portfolio.totals.reduce((s,t) =\u003e s + (t.dayPnl||0), 0))\"\u003e\n        \u003cspan class=\"day-label\"\u003eToday\u003c/span\u003e\n        \u003cspan class=\"day-value combined-day\"\u003e\n          \u003cspan v-for=\"(t, i) in portfolio.totals\" :key=\"t.currency\" :class=\"gainLossClass(t.dayPnl)\"\u003e\n            \u003cspan v-if=\"i \u003e 0\" class=\"text-muted\"\u003e · \u003c/span\u003e\n            {{ t.dayPnl \u003e= 0 ? '+' : '' }}{{ useCurrency(t.dayPnl, t.currency) }}\n          \u003c/span\u003e\n        \u003c/span\u003e\n      \u003c/div\u003e",
          "old_string": "      \u003c!-- Per-currency totals --\u003e\n      \u003cdiv\n        v-for=\"t in portfolio.totals\"\n        :key=\"t.currency\"\n        class=\"summary-card\"\n      \u003e\n        \u003cp class=\"summary-label\"\u003eTotal Value · {{ t.currency }}\u003c/p\u003e\n        \u003cp class=\"summary-value\"\u003e{{ useCurrency(t.value, t.currency) }}\u003c/p\u003e\n        \u003cp class=\"summary-pnl\" :class=\"gainLossClass(t.pnl)\"\u003e\n          {{ useCurrency(t.pnl, t.currency) }} ({{ usePercent(t.pnlPercent) }})\n        \u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv v-if=\"!portfolio.totals?.length \u0026\u0026 !portfolio.positions?.length\" class=\"summary-card\"\u003e\n        \u003cp class=\"summary-label\"\u003eTotal Value\u003c/p\u003e\n        \u003cp class=\"summary-value\"\u003e$0.00\u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Day P\u0026L per currency --\u003e\n      \u003cdiv\n        v-for=\"t in portfolio.totals\"\n        :key=\"`day-${t.currency}`\"\n        class=\"day-card\"\n        :class=\"gainLossClass(t.dayPnl)\"\n      \u003e\n        \u003cspan class=\"day-label\"\u003eToday · {{ t.currency }}\u003c/span\u003e\n        \u003cspan class=\"day-value\"\u003e\n          {{ t.dayPnl \u003e= 0 ? '+' : '' }}{{ useCurrency(t.dayPnl, t.currency) }}\n          ({{ usePercent(t.dayPnlPercent) }})\n        \u003c/span\u003e\n      \u003c/div\u003e",
