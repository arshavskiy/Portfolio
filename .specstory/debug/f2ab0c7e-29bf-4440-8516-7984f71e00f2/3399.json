    "originalFile": "\u003cscript setup\u003e\nimport { useRoute } from 'vue-router'\n\nconst route = useRoute()\n\nconst tabs = [\n  { name: 'Dashboard', to: '/', icon: 'pi pi-chart-bar', label: 'Dashboard' },\n  { name: 'Holdings', to: '/holdings', icon: 'pi pi-briefcase', label: 'Holdings' },\n  { name: 'Watchlist', to: '/watchlist', icon: 'pi pi-eye', label: 'Watchlist' },\n  { name: 'Transactions', to: '/transactions', icon: 'pi pi-list', label: 'History' },\n  { name: 'Profile', to: '/profile', icon: 'pi pi-user', label: 'Profile' },\n]\n\nfunction isActive(tab) {\n  if (tab.to === '/') return route.path === '/'\n  return route.path.startsWith(tab.to)\n}\n\u003c/script\u003e\n\n\u003ctemplate\u003e\n  \u003cnav class=\"bottom-nav\"\u003e\n    \u003cRouterLink\n      v-for=\"tab in tabs\"\n      :key=\"tab.name\"\n      :to=\"tab.to\"\n      class=\"nav-item\"\n      :class=\"{ active: isActive(tab) }\"\n    \u003e\n      \u003ci :class=\"tab.icon\" /\u003e\n      \u003cspan\u003e{{ tab.label }}\u003c/span\u003e\n    \u003c/RouterLink\u003e\n  \u003c/nav\u003e\n\u003c/template\u003e\n\n\u003cstyle scoped\u003e\n.bottom-nav {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: calc(var(--nav-height) + var(--safe-bottom));\n  padding-bottom: var(--safe-bottom);\n  background: var(--bg-secondary);\n  border-top: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  z-index: 100;\n}\n.nav-item {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 3px;\n  padding: 8px 0;\n  text-decoration: none;\n  color: var(--text-secondary);\n  font-size: 10px;\n  transition: color 0.2s;\n}\n.nav-item i { font-size: 20px; }\n.nav-item.active { color: var(--accent); }\n\u003c/style\u003e\n",
