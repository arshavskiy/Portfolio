      "content": "\u003cscript setup\u003e\nimport { ref, watch, onMounted, nextTick } from 'vue'\nimport * as d3 from 'd3'\nimport { useCurrency, tickerCurrency } from '@/composables/useFormat'\n\nconst props = defineProps({\n  positions: { type: Array, default: () =\u003e [] },\n})\n\nconst svgRef = ref(null)\n\nconst COLORS = ['#3b82f6','#22c55e','#f59e0b','#ef4444','#8b5cf6','#06b6d4','#ec4899','#84cc16']\n\nfunction draw() {\n  if (!svgRef.value || !props.positions.length) return\n\n  const svg = d3.select(svgRef.value)\n  svg.selectAll('*').remove()\n\n  const W = 280\n  const H = 200\n  const radius = Math.min(W, H) / 2 - 10\n  const innerRadius = radius * 0.55\n\n  svg.attr('viewBox', `0 0 ${W} ${H}`).attr('width', '100%').attr('height', H)\n\n  const g = svg.append('g').attr('transform', `translate(${W / 2},${H / 2})`)\n\n  const pie = d3.pie().value((d) =\u003e d.value).sort(null)\n  const arc = d3.arc().innerRadius(innerRadius).outerRadius(radius).cornerRadius(3).padAngle(0.02)\n  const hoverArc = d3.arc().innerRadius(innerRadius).outerRadius(radius + 6).cornerRadius(3).padAngle(0.02)\n\n  const data = props.positions.map((p, i) =\u003e ({\n    ticker: p.ticker,\n    value: p.value,\n    color: COLORS[i % COLORS.length],\n  }))\n\n  const arcs = g.selectAll('.arc').data(pie(data)).enter().append('g').attr('class', 'arc')\n\n  arcs.append('path')\n    .attr('fill', (d) =\u003e d.data.color)\n    .attr('d', arc)\n    .style('cursor', 'pointer')\n    .on('mouseover', function (_, d) { d3.select(this).attr('d', hoverArc) })\n    .on('mouseout', function (_, d) { d3.select(this).attr('d', arc) })\n\n  // Center label — detect dominant currency\n  const currency = props.positions.every(p =\u003e tickerCurrency(p.ticker) === 'ILS') ? 'ILS'\n    : props.positions.every(p =\u003e tickerCurrency(p.ticker) === 'USD') ? 'USD' : 'mixed'\n  const total = d3.sum(data, (d) =\u003e d.value)\n  const totalLabel = currency === 'mixed' ? '—' : useCurrency(total, currency)\n  g.append('text').attr('text-anchor', 'middle').attr('dy', '-0.2em')\n    .attr('fill', '#94a3b8').attr('font-size', '11')\n    .text('Total')\n  g.append('text').attr('text-anchor', 'middle').attr('dy', '1em')\n    .attr('fill', '#f1f5f9').attr('font-size', '14').attr('font-weight', '600')\n    .text(totalLabel)\n}\n\nonMounted(() =\u003e nextTick(draw))\nwatch(() =\u003e props.positions, () =\u003e nextTick(draw), { deep: true })\n\u003c/script\u003e\n\n\u003ctemplate\u003e\n  \u003cdiv v-if=\"positions.length\" class=\"allocation-wrap\"\u003e\n    \u003ch2 class=\"section-title\"\u003eAllocation\u003c/h2\u003e\n    \u003cdiv class=\"chart-row\"\u003e\n      \u003csvg ref=\"svgRef\" /\u003e\n      \u003cdiv class=\"legend\"\u003e\n        \u003cdiv v-for=\"(pos, i) in positions\" :key=\"pos.ticker\" class=\"legend-item\"\u003e\n          \u003cspan class=\"legend-dot\" :style=\"{ background: ['#3b82f6','#22c55e','#f59e0b','#ef4444','#8b5cf6','#06b6d4','#ec4899','#84cc16'][i % 8] }\" /\u003e\n          \u003cspan class=\"legend-ticker\"\u003e{{ pos.ticker }}\u003c/span\u003e\n          \u003cspan class=\"legend-pct text-muted\"\u003e{{ pos.value \u0026\u0026 positions.reduce((s,p)=\u003es+p.value,0) \u003e 0 ? ((pos.value / positions.reduce((s,p)=\u003es+p.value,0)) * 100).toFixed(1) + '%' : '' }}\u003c/span\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/template\u003e\n\n\u003cstyle scoped\u003e\n.allocation-wrap { margin-bottom: 1rem; }\n.section-title { font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; }\n.chart-row { display: flex; align-items: center; gap: 1rem; }\nsvg { flex: 0 0 auto; width: 160px; }\n.legend { display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }\n.legend-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; }\n.legend-dot { width: 8px; height: 8px; border-radius: