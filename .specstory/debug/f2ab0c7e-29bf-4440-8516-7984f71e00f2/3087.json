     \u003cp class=\"summary-label\"\u003eTotal Portfolio\u003c/p\u003e\n        \u003cp class=\"summary-value\"\u003e$0.00\u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Day P\u0026L per currency --\u003e\n      \u003cdiv class=\"day-card\" :class=\"gainLossClass(portfolio.totals.reduce((s,t) =\u003e s + (t.dayPnl||0), 0))\"\u003e\n        \u003cspan class=\"day-label\"\u003eToday\u003c/span\u003e\n        \u003cspan class=\"day-value combined-day\"\u003e\n          \u003cspan v-for=\"(t, i) in portfolio.totals\" :key=\"t.currency\" :class=\"gainLossClass(t.dayPnl)\"\u003e\n            \u003cspan v-if=\"i \u003e 0\" class=\"text-muted\"\u003e · \u003c/span\u003e\n            {{ t.dayPnl \u003e= 0 ? '+' : '' }}{{ useCurrency(t.dayPnl, t.currency) }}\n          \u003c/span\u003e\n        \u003c/span\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Allocation donut --\u003e\n      \u003cAllocationChart :positions=\"portfolio.positions\" :combined-usd=\"portfolio.combinedUsd\" /\u003e\n\n      \u003c!-- Top movers --\u003e\n      \u003csection v-if=\"portfolio.positions.length \u003e 1\" class=\"section\"\u003e\n        \u003ch2\u003eToday's Movers\u003c/h2\u003e\n        \u003cTopMoversChart :positions=\"portfolio.positions\" /\u003e\n      \u003c/section\u003e\n\n      \u003c!-- Holdings list --\u003e\n      \u003csection class=\"section\"\u003e\n        \u003ch2\u003eHoldings\u003c/h2\u003e\n        \u003cdiv\n          v-for=\"pos in portfolio.positions\"\n          :key=\"pos.ticker\"\n          class=\"holding-row\"\n          @click=\"$router.push(`/stock/${pos.ticker}`)\"\n        \u003e\n          \u003cdiv class=\"holding-left\"\u003e\n            \u003cspan class=\"ticker\"\u003e{{ pos.ticker }}\u003c/span\u003e\n            \u003cspan class=\"company text-muted\"\u003e{{ pos.companyName }}\u003c/span\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"holding-right\"\u003e\n            \u003cspan class=\"price\"\u003e{{ useTickerCurrenc