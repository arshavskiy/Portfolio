          "new_string": "      \u003c!-- Combined USD total (shown when mixed currencies) --\u003e\n      \u003cdiv v-if=\"portfolio.combinedUsd \u0026\u0026 portfolio.totals.length \u003e 1\" class=\"summary-card combined-card\"\u003e\n        \u003cp class=\"summary-label\"\u003e\n          Total Portfolio · USD\n          \u003cspan class=\"fx-rate text-muted\" v-if=\"portfolio.combinedUsd.ilsToUsd\"\u003e\n            (₪1 = ${{ portfolio.combinedUsd.ilsToUsd.toFixed(4) }})\n          \u003c/span\u003e\n        \u003c/p\u003e\n        \u003cp class=\"summary-value\"\u003e{{ useCurrency(portfolio.combinedUsd.value, 'USD') }}\u003c/p\u003e\n        \u003cp class=\"summary-pnl\" :class=\"gainLossClass(portfolio.combinedUsd.pnl)\"\u003e\n          {{ useCurrency(portfolio.combinedUsd.pnl, 'USD') }} ({{ usePercent(portfolio.combinedUsd.pnlPercent) }})\n        \u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Per-currency totals --\u003e\n      \u003cdiv\n        v-for=\"t in portfolio.totals\"\n        :key=\"t.currency\"\n        class=\"summary-card\"\n      \u003e\n        \u003cp class=\"summary-label\"\u003eTotal Value · {{ t.currency }}\u003c/p\u003e\n        \u003cp class=\"summary-value\"\u003e{{ useCurrency(t.value, t.currency) }}\u003c/p\u003e\n        \u003cp class=\"summary-pnl\" :class=\"gainLossClass(t.pnl)\"\u003e\n          {{ useCurrency(t.pnl, t.currency) }} ({{ usePercent(t.pnlPercent) }})\n        \u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv v-if=\"!portfolio.totals?.length \u0026\u0026 !portfolio.positions?.length\" class=\"summary-card\"\u003e\n        \u003cp class=\"summary-label\"\u003eTotal Value\u003c/p\u003e\n        \u003cp class=\"summary-value\"\u003e$0.00\u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Day P\u0026L — combined if mixed --\u003e\n      \u003cdiv\n        v-if=\"portfolio.combinedUsd \u0026\u0026 portfolio.totals.length \u003e 1\"\n        class=\"day-card\"\n        :class=\"gainLossClass(portfolio.combinedUsd.dayPnl)\"\n      \u003e\n        \u003cspan class=\"day-label\"\u003eToday · USD (combined)\u003c/span\u003e\n        \u003cspan class=\"day-value\"\u003e\n          {{ portfolio.combinedUsd.dayPnl \u003e= 0 ? '+' : '' }}{{ useCurrency(portfolio.combinedUsd.dayPnl, 'USD') }}\n          ({{ usePercent(portfolio.combinedUsd.dayPnlPercent) }})\n        \u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv\n        v-else\n        v-for=\"t in portfolio.totals\"\n        :key=\"`day-${t.currency}`\"\n        class=\"day-card\"\n        :class=\"gainLossClass(t.dayPnl)\"\n      \u003e\n        \u003cspan class=\"day-label\"\u003eToday · {{ t.currency }}\u003c/span\u003e\n        \u003cspan class=\"day-value\"\u003e\n          {{ t.dayPnl \u003e= 0 ? '+' : '' }}{{ useCurrency(t.dayPnl, t.currency) }}\n          ({{ usePercent(t.dayPnlPercent) }})\n        \u003c/span\u003e\n      \u003c/div\u003e",
