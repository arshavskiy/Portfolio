        "input": {
          "content": "\u003cscript setup\u003e\nimport { ref, watch } from 'vue'\nimport { useToast } from 'primevue/usetoast'\nimport { usePortfolioStore } from '@/stores/portfolio'\nimport api from '@/composables/useApi'\nimport Dialog from 'primevue/dialog'\nimport InputText from 'primevue/inputtext'\nimport InputNumber from 'primevue/inputnumber'\nimport SelectButton from 'primevue/selectbutton'\nimport Button from 'primevue/button'\nimport AutoComplete from 'primevue/autocomplete'\n\nconst props = defineProps({\n  visible: Boolean,\n  defaultTicker: { type: String, default: '' },\n})\nconst emit = defineEmits(['update:visible'])\n\nconst toast = useToast()\nconst portfolio = usePortfolioStore()\n\nconst type = ref('buy')\nconst ticker = ref('')\nconst shares = ref(null)\nconst price = ref(null)\nconst loading = ref(false)\nconst suggestions = ref([])\n\nwatch(() =\u003e props.visible, (v) =\u003e {\n  if (v) {\n    ticker.value = props.defaultTicker || ''\n    shares.value = null\n    price.value = null\n    type.value = 'buy'\n  }\n})\n\nasync function searchTicker(event) {\n  if (!event.query || event.query.length \u003c 1) { suggestions.value = []; return }\n  try {\n    const results = await api.get(`/stocks/search?q=${encodeURIComponent(event.query)}`)\n    suggestions.value = results.map((r) =\u003e ({ label: `${r.ticker} — ${r.name}`, value: r.ticker }))\n  } catch { suggestions.value = [] }\n}\n\nasync function submit() {\n  const t = typeof ticker.value === 'object' ? ticker.value.value : ticker.value\n  if (!t || !shares.value || !price.value) {\n    toast.add({ severity: 'warn', summary: 'Fill all fields', life: 2000 })\n    return\n  }\n  loading.value = true\n  try {\n    await portfolio.addTransaction({ ticker: t, type: type.value, shares: shares.value, price: price.value })\n    toast.add({ severity: 'success', summary: `${type.value === 'buy' ? 'Bought' : 'Sold'} ${t}`, life: 2000 })\n    emit('update:visible', false)\n  } catch (err) {\n    toast.add({ severity: 'error', summary: 'Error', detail: err.message, life: 3000 })\n  } finally {\n    loading.value = false\n  }\n}\n\u003c/script\u003e\n\n\u003ctemplate\u003e\n  \u003cDialog\n    :visible=\"visible\"\n    @update:visible=\"emit('update:visible', $event)\"\n    modal\n    :header=\"type === 'buy' ? 'Buy Stock' : 'Sell Stock'\"\n    :style=\"{ width: '95vw', maxWidth: '420px' }\"\n    :draggable=\"false\"\n  \u003e\n    \u003cdiv class=\"tx-form\"\u003e\n      \u003cSelectButton v-model=\"type\" :options=\"['buy', 'sell']\" class=\"type-select\" /\u003e\n\n      \u003cdiv class=\"field\"\u003e\n        \u003clabel\u003eTicker\u003c/label\u003e\n        \u003cAutoComplete\n          v-model=\"ticker\"\n          :suggestions=\"suggestions\"\n          option-label=\"label\"\n          @complete=\"searchTicker\"\n          placeholder=\"AAPL, TSLA...\"\n          fluid\n          force-selection\n        /\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"field\"\u003e\n        \u003clabel\u003eShares\u003c/label\u003e\n        \u003cInputNumber v-model=\"shares\" :min=\"0.001\" :max-fraction-digits=\"4\" placeholder=\"0\" fluid /\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"field\"\u003e\n        \u003clabel\u003ePrice per share\u003c/label\u003e\n        \u003cInputNumber v-model=\"price\" mode=\"currency\" currency=\"USD\" :min=\"0.01\" :max-fraction-digits=\"4\" placeholder=\"$0.00\" fluid /\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"total-row\" v-if=\"shares \u0026\u0026 price\"\u003e\n        \u003cspan class=\"text-muted\"\u003eTotal\u003c/span\u003e\n        \u003cspan\u003e${{ (shares * price).toFixed(2) }}\u003c/span\u003e\n      \u003c/div\u003e\n\n      \u003cButton\n        :label=\"type === 'buy' ? 'Buy' : 'Sell'\"\n        :severity=\"type === 'buy' ? 'success' : 'danger'\"\n        :loading=\"loading\"\n        fluid\n        @click=\"submit\"\n      /\u003e\n    \u003c/div\u003e\n  \u003c/Dialog\u003e\n\u003c/template\u003e\n\n\u003cstyle scoped\u003e\n.tx-form { display: flex; flex-direction: column; gap: 1rem; }\n.type-select { align-self: center; }\n.field { display: flex; flex-direction: column; gap: 0.4rem; }\n.field label { font-size: 0.85rem; color: var(--text-secondary); }\n.total-row { display: flex; justify-content: space-between; padding: 0.5rem 0; border-top: 1px solid var(--border); font-size: 0.9rem; }\n\u003c/style\u003e\n",
