class=\"price\"\u003e{{ useCurrency(pos.currentPrice) }}\u003c/span\u003e\n            \u003cspan :class=\"gainLossClass(pos.changePercent)\" class=\"change\"\u003e\n              {{ usePercent(pos.changePercent) }}\n            \u003c/span\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cp v-if=\"!portfolio.positions.length\" class=\"empty text-muted\"\u003e\n          No holdings yet. Add a transaction to get started.\n        \u003c/p\u003e\n      \u003c/section\u003e\n    \u003c/template\u003e\n  \u003c/div\u003e\n\u003c/template\u003e\n\n\u003cstyle scoped\u003e\n.dashboard { padding: 1rem; }\n.dash-header { margin-bottom: 1.5rem; }\n.dash-header h1 { font-size: 1.5rem; font-weight: 700; }\n\n.summary-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  padding: 1.5rem;\n  margin-bottom: 1rem;\n  text-align: center;\n}\n.summary-label { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem; }\n.summary-value { font-size: 2rem; font-weight: 700; }\n.summary-pnl { font-size: 1rem; margin-top: 0.25rem; }\n\n.section { margin-top: 1.5rem; }\n.section h2 { font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; }\n\n.holding-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.85rem 0;\n  border-bottom: 1px solid var(--border);\n  cursor: pointer;\n}\n.holding-left { display: flex; flex-direction: column; gap: 2px; }\n.holding-right { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }\n.ticker { font-weight: 600; font-size: 1rem; }\n.company { font-size: 0.8rem; }\n.price { font-size: 0.95rem; }\n.change { font-size: 0.85rem; }\n.empty { padding: 1rem 0; font-size: 0.9rem; }\n\u003c/style\u003e\n",
