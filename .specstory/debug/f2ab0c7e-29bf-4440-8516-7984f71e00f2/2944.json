    "originalFile": "\u003cscript setup\u003e\n// v2\nimport { onMounted } from 'vue'\nimport { usePortfolioStore } from '@/stores/portfolio'\nimport { useTickerCurrency, useCurrency, usePercent, gainLossClass } from '@/composables/useFormat'\nimport AllocationChart from '@/components/charts/AllocationChart.vue'\nimport TopMoversChart from '@/components/charts/TopMoversChart.vue'\nimport SkeletonCard from '@/components/ui/SkeletonCard.vue'\n\nconst portfolio = usePortfolioStore()\n\nonMounted(() =\u003e portfolio.fetchPortfolio())\n\u003c/script\u003e\n\n\u003ctemplate\u003e\n  \u003cdiv class=\"dashboard\"\u003e\n    \u003cheader class=\"dash-header\"\u003e\n      \u003ch1\u003ePortfolio\u003c/h1\u003e\n    \u003c/header\u003e\n\n    \u003cdiv v-if=\"portfolio.loading\" class=\"cards-grid\"\u003e\n      \u003cSkeletonCard v-for=\"n in 3\" :key=\"n\" /\u003e\n    \u003c/div\u003e\n\n    \u003ctemplate v-else\u003e\n      \u003c!-- Combined USD total (shown when mixed currencies) --\u003e\n      \u003cdiv v-if=\"portfolio.combinedUsd \u0026\u0026 portfolio.totals.length \u003e 1\" class=\"summary-card combined-card\"\u003e\n        \u003cp class=\"summary-label\"\u003e\n          Total Portfolio · USD\n          \u003cspan class=\"fx-rate text-muted\" v-if=\"portfolio.combinedUsd.ilsToUsd\"\u003e\n            (₪1 = ${{ portfolio.combinedUsd.ilsToUsd.toFixed(4) }})\n          \u003c/span\u003e\n        \u003c/p\u003e\n        \u003cp class=\"summary-value\"\u003e{{ useCurrency(portfolio.combinedUsd.value, 'USD') }}\u003c/p\u003e\n        \u003cp class=\"summary-pnl\" :class=\"gainLossClass(portfolio.combinedUsd.pnl)\"\u003e\n          {{ useCurrency(portfolio.combinedUsd.pnl, 'USD') }} ({{ usePercent(portfolio.combinedUsd.pnlPercent) }})\n        \u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Per-currency totals --\u003e\n      \u003cdiv\n        v-for=\"t in portfolio.totals\"\n        :key=\"t.currency\"\n        class=\"summary-card\"\n      \u003e\n        \u003cp class=\"summary-label\"\u003eTotal Value · {{ t.currency }}\u003c/p\u003e\n        \u003cp class=\"summary-value\"\u003e{{ useCurrency(t.value, t.currency) }}\u003c/p\u003e\n        \u003cp class=\"summary-pnl\" :class=\"gainLossClass(t.pnl)\"\u003e\n          {{ useCurrency(t.pnl, t.currency) }} ({{ usePercent(t.pnlPercent) }})\n        \u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv v-if=\"!portfolio.totals?.length \u0026\u0026 !portfolio.positions?.length\" class=\"summary-card\"\u003e\n        \u003cp class=\"summary-label\"\u003eTotal Value\u003c/p\u003e\n        \u003cp class=\"summary-value\"\u003e$0.00\u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Day P\u0026L — combined if mixed --\u003e\n      \u003cdiv\n        v-if=\"portfolio.combinedUsd \u0026\u0026 portfolio.totals.length \u003e 1\"\n        class=\"day-card\"\n        :class=\"gainLossClass(portfolio.combinedUsd.dayPnl)\"\n      \u003e\n        \u003cspan class=\"day-label\"\u003eToday · USD (combined)\u003c/span\u003e\n        \u003cspan class=\"day-value\"\u003e\n          {{ portfolio.combinedUsd.dayPnl \u003e= 0 ? '+' : '' }}{{ useCurrency(portfolio.combinedUsd.dayPnl, 'USD') }}\n          ({{ usePercent(portfolio.combinedUsd.dayPnlPercent) }})\n        \u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv\n        v-else\n        v-for=\"t in portfolio.totals\"\n        :key=\"`day-${t.currency}`\"\n        class=\"day-card\"\n        :class=\"gainLossClass(t.dayPnl)\"\n      \u003e\n        \u003cspan class=\"day-label\"\u003eToday · {{ t.currency }}\u003c/span\u003e\n        \u003cspan class=\"day-value\"\u003e\n          {{ t.dayPnl \u003e= 0 ? '+' : '' }}{{ useCurrency(t.dayPnl, t.currency) }}\n          ({{ usePercent(t.dayPnlPercent) }})\n        \u003c/span\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Allocation donut --\u003e\n      \u003cAllocationChart :positions=\"portfolio.positions\" /\u003e\n\n      \u003c!-- Top movers --\u003e\n      \u003csection v-if=\"portfolio.positions.length \u003e 1\" class=\"section\"\u003e\n        \u003ch2\u003eToday's Movers\u003c/h2\u003e\n        \u003cTopMoversChart :positions=\"portfolio.positions\" /\u003e\n      \u003c/section\u003e\n\n      \u003c!-- Holdings list --\u003e\n      \u003csection class=\"section\"\u003e\n        \u003ch2\u003eHoldings\u003c/h2\u003e\n        \u003cdiv\n          v-for=\"pos in portfolio.positions\"\n          :key=\"pos.ticker\"\n          class=\"holding-row\"\n          @click=\"$router.push(`/stock/${pos.ticker}`)\"\n        \u003e\n          \u003cdiv class=\"holding-left\"\u003e\n            \u003cspan class=\"ticker\"\u003e{{ pos.ticker }}\u003c/span\u003e\n            \u003cspan class=\"company text-muted\"\u003e{{ pos.companyName }}\u003c/span\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"holding-right\"\u003e\n            \u003cspan class=\"price\"\u003e{{ useTickerCurrency(pos.currentPrice, pos.ticker) }}\u003c/span\u003e\n            \u003cspan :class=\"gainLossClass(pos.changePercent)\" class=\"change\"\u003e\n              {{ usePercent(pos.changePercent) }}\n            \u003c/span\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cp v-if=\"!portfolio.positions.length\" class=\"empty text-muted\"\u003e\n          No holdings yet. Add a transaction to get started.\n        \u003c/p\u003e\n      \u003c/section\u003e\n    \u003c/template\u003e\n  \u003c/div\u003e\n\u003c/template\u003e\n\n\u003cstyle scoped\u003e\n.dashboard { padding: 1rem; }\n.dash-header { margin-bottom: 1.5rem; }\n.dash-header h1 { font-size: 1.5rem; font-weight: 700; }\n\n.summary-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  padding: 1.5rem;\n  margin-bottom: 0.75rem;\n  text-align: center;\n}\n.summary-label { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem; display: flex; align-items: center; justify-content: center; gap: 0.4rem; flex-wrap: wrap; }\n.combined-card { border-color: var(--accent); background: rgba(59,130,246,0.05); }\n.fx-rate { font-size: 0.75rem; }\n.summary-value { font-size: 2rem; font-weight: 700; }\n.summary-pnl { font-size: 1rem; margin-top: 0.25rem; }\n\n.day-card {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 0.75rem 1rem;\n  margin-bottom: 0.75rem;\n  font-size: 0.9rem;\n}\n.day-label { color: var(--text-secondary); font-size: 0.82rem; }\n.day-value { font-weight: 600; }\n.day-card.gain { border-color: rgba(34,197,94,0.3); }\n.day-card.loss { border-color: rgba(239,68,68,0.3); }\n\n.section { margin-top: 1.5rem; }\n.section h2 { font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; }\n\n.holding-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.85rem 0;\n  border-bottom: 1px solid var(--border);\n  cursor: pointer;\n}\n.holding-left { display: flex; flex-direction: column; gap: 2px; }\n.holding-right { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }\n.ticker { font-weight: 600; font-size: 1rem; }\n.company { font-size: 0.8rem; }\n.price { font-size: 0.95rem; }\n.change { font-size: 0.85rem; }\n.empty { padding: 1rem 0; font-size: 0.9rem; }\n\u003c/style\u003e\n",
